<Window x:Class="MacWinUI.App.Dialogs.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacWinUI"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable, Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Margin="18"
            Padding="20"
            CornerRadius="16"
            Background="{DynamicResource ControlCenterBackgroundBrush}"
            BorderBrush="{DynamicResource ControlCenterBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#99000000"
                              BlurRadius="28"
                              ShadowDepth="8"
                              Opacity="0.7" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText"
                       Style="{StaticResource ControlCenterTitleStyle}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="0,10,0,20"
                       Foreground="{DynamicResource MenuBarTextBrush}"
                       FontSize="13"
                       LineHeight="20"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        MinWidth="78"
                        Margin="0,0,8,0"
                        Style="{StaticResource ControlCenterCompactButtonStyle}"
                        Click="OnCancelClick" />
                <Button x:Name="PrimaryButton"
                        MinWidth="78"
                        Style="{StaticResource ControlCenterCompactButtonStyle}"
                        IsDefault="True"
                        Click="OnPrimaryClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
