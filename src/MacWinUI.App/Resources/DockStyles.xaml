<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DockBackdropStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DockBackgroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource DockShadowColor}"
                                  BlurRadius="26"
                                  Direction="270"
                                  ShadowDepth="5"
                                  Opacity="0.38" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockInnerHighlightStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DockGlassHighlightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="DockFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DockBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="DockItemButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource DockItemBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
        <Setter Property="ToolTipService.ShowDuration" Value="5000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="HoverSurface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverSurface"
                                    Property="Background"
                                    Value="{DynamicResource DockHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverSurface" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HoverSurface" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockIconTileStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="BorderBrush" Value="{DynamicResource DockGlassHighlightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource DockIconShadowColor}"
                                  BlurRadius="10"
                                  Direction="270"
                                  ShadowDepth="2"
                                  Opacity="0.34" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockToolTipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Placement" Value="Top" />
        <Setter Property="HorizontalOffset" Value="0" />
        <Setter Property="VerticalOffset" Value="-4" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource DockTooltipBackgroundBrush}"
                            BorderBrush="{DynamicResource DockBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource DockShadowColor}"
                                              BlurRadius="10"
                                              Direction="270"
                                              ShadowDepth="2"
                                              Opacity="0.22" />
                        </Border.Effect>
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="12" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockRunningIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="4.5" />
        <Setter Property="Height" Value="4.5" />
        <Setter Property="Fill" Value="{DynamicResource DockIndicatorBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsRunning}" Value="True" />
                    <Condition Binding="{Binding IsActive}" Value="False" />
                    <Condition Binding="{Binding ShowRunningIndicators, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DockActiveIndicatorStyle" TargetType="Border">
        <Setter Property="Width" Value="4.5" />
        <Setter Property="Height" Value="4.5" />
        <Setter Property="CornerRadius" Value="2.25" />
        <Setter Property="Background" Value="{DynamicResource DockActiveIndicatorBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsActive}" Value="True" />
                    <Condition Binding="{Binding ShowActiveIndicator, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DockSeparatorStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="Background" Value="{DynamicResource DockSeparatorBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="DockContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="MousePoint" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border MinWidth="210"
                            Padding="5"
                            Background="{DynamicResource ControlCenterBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlCenterBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource DockShadowColor}"
                                              BlurRadius="18"
                                              Direction="270"
                                              ShadowDepth="4"
                                              Opacity="0.34" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockContextMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemSurface"
                            Height="{TemplateBinding Height}"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="6">
                        <Grid MinWidth="180">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckGlyph"
                                       Text="✓"
                                       FontWeight="SemiBold"
                                       Visibility="Collapsed"
                                       VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface"
                                    Property="Background"
                                    Value="{DynamicResource ControlCenterAccentBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ControlCenterSelectedTextBrush}" />
                            <Setter TargetName="CheckGlyph"
                                    Property="Foreground"
                                    Value="{DynamicResource ControlCenterSelectedTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ItemSurface" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
