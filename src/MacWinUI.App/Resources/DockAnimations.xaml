<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Storyboard x:Key="DockAppearStoryboard" x:Shared="False">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DockRoot"
                                       Storyboard.TargetProperty="Opacity">
            <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.18"
                                  KeySpline="0.16,1 0.3,1"
                                  Value="1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DockTranslate"
                                       Storyboard.TargetProperty="Y">
            <DiscreteDoubleKeyFrame KeyTime="0" Value="10" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.22"
                                  KeySpline="0.16,1 0.3,1"
                                  Value="0" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="DockItemBounceStoryboard" x:Shared="False">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ClickTranslate"
                                       Storyboard.TargetProperty="Y"
                                       Duration="0:0:0.32">
            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.10"
                                  KeySpline="0.16,1 0.3,1"
                                  Value="-8" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.22"
                                  KeySpline="0.65,0 0.35,1"
                                  Value="1" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.32"
                                  KeySpline="0.16,1 0.3,1"
                                  Value="0" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
</ResourceDictionary>
