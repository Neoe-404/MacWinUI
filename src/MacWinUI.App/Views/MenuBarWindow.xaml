<Window x:Class="MacWinUI.App.Views.MenuBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:MacWinUI.Core.Dock;assembly=MacWinUI.Core"
        Title="MacWinUI Menu Bar"
        Height="30"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        DpiChanged="OnDpiChanged"
        Loaded="OnLoaded">
    <Border Style="{StaticResource MenuBarBackdropStyle}">
        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Grid Width="17" Height="17" Margin="1,0,11,0" VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource MenuBarTextBrush}" />
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{DynamicResource MenuBarBackgroundBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Grid>
                <Menu Style="{StaticResource MenuBarMenuStyle}">
                    <MenuItem Header="{Binding ActiveApplicationName}"
                              FontWeight="SemiBold"
                              Style="{StaticResource MenuBarTopLevelMenuItemStyle}"
                              ItemContainerStyle="{StaticResource MenuBarSubMenuItemStyle}">
                        <MenuItem Header="{DynamicResource String.Menu.About}" Click="OnAboutClick" />
                        <MenuItem Header="{DynamicResource String.Menu.ControlCenter}" Click="OnShowControlCenterClick" />
                        <MenuItem Header="{DynamicResource String.Menu.Quit}" Click="OnQuitClick" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource String.Menu.File}"
                              Style="{StaticResource MenuBarTopLevelMenuItemStyle}"
                              ItemContainerStyle="{StaticResource MenuBarSubMenuItemStyle}">
                        <MenuItem Header="{DynamicResource String.Menu.Explorer}"
                                  InputGestureText="Win+E"
                                  Click="OnOpenExplorerClick" />
                        <MenuItem Header="{DynamicResource String.Menu.AddDock}"
                                  Click="OnAddDockItemClick" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource String.Menu.Edit}"
                              Style="{StaticResource MenuBarTopLevelMenuItemStyle}"
                              ItemContainerStyle="{StaticResource MenuBarSubMenuItemStyle}">
                        <MenuItem Header="{DynamicResource String.Menu.Appearance}"
                                  Click="OnShowControlCenterClick" />
                        <MenuItem Header="{DynamicResource String.Menu.SoundSettings}"
                                  Click="OnOpenSoundSettingsClick" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource String.Menu.View}"
                              Style="{StaticResource MenuBarTopLevelMenuItemStyle}"
                              ItemContainerStyle="{StaticResource MenuBarSubMenuItemStyle}"
                              SubmenuOpened="OnViewMenuOpened">
                        <MenuItem x:Name="BigSurThemeMenuItem"
                                  Header="BigSur Theme"
                                  IsCheckable="True"
                                  Tag="{x:Static dock:DockTheme.BigSur}"
                                  Click="OnThemeClick" />
                        <MenuItem x:Name="AutoThemeMenuItem"
                                  Header="Auto Theme"
                                  IsCheckable="True"
                                  Tag="{x:Static dock:DockTheme.Auto}"
                                  Click="OnThemeClick" />
                        <MenuItem x:Name="LightThemeMenuItem"
                                  Header="Light Theme"
                                  IsCheckable="True"
                                  Tag="{x:Static dock:DockTheme.Light}"
                                  Click="OnThemeClick" />
                        <MenuItem x:Name="DarkThemeMenuItem"
                                  Header="Dark Theme"
                                  IsCheckable="True"
                                  Tag="{x:Static dock:DockTheme.Dark}"
                                  Click="OnThemeClick" />
                        <MenuItem x:Name="MagnificationMenuItem"
                                  Header="Dock Magnification"
                                  IsCheckable="True"
                                  Click="OnToggleMagnificationClick" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource String.Menu.Go}"
                              Style="{StaticResource MenuBarTopLevelMenuItemStyle}"
                              ItemContainerStyle="{StaticResource MenuBarSubMenuItemStyle}">
                        <MenuItem Header="{DynamicResource String.Menu.Home}" Tag="UserProfile" Click="OnOpenFolderClick" />
                        <MenuItem Header="{DynamicResource String.Menu.Desktop}" Tag="Desktop" Click="OnOpenFolderClick" />
                        <MenuItem Header="{DynamicResource String.Menu.Downloads}" Tag="Downloads" Click="OnOpenFolderClick" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource String.Menu.Window}"
                              Style="{StaticResource MenuBarTopLevelMenuItemStyle}"
                              ItemContainerStyle="{StaticResource MenuBarSubMenuItemStyle}">
                        <MenuItem Header="{DynamicResource String.Menu.ShowDock}" Click="OnShowDockClick" />
                        <MenuItem Header="{DynamicResource String.Menu.ControlCenter}" Click="OnShowControlCenterClick" />
                        <MenuItem Header="{DynamicResource String.Menu.Reposition}"
                                  Click="OnRepositionWindowsClick" />
                    </MenuItem>

                    <MenuItem Header="{DynamicResource String.Menu.Help}"
                              Style="{StaticResource MenuBarTopLevelMenuItemStyle}"
                              ItemContainerStyle="{StaticResource MenuBarSubMenuItemStyle}">
                        <MenuItem Header="{DynamicResource String.Menu.Tips}" Click="OnShowTipsClick" />
                        <MenuItem Header="{DynamicResource String.Menu.Diagnostics}" Click="OnShowDiagnosticsClick" />
                        <MenuItem Header="{DynamicResource String.Menu.About}" Click="OnAboutClick" />
                    </MenuItem>
                </Menu>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="&#xE701;"
                           ToolTip="Network"
                           Visibility="{Binding ShowNetworkStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"
                               BasedOn="{StaticResource MenuBarStatusGlyphStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNetworkAvailable}" Value="False">
                                    <Setter Property="Text" Value="&#xE8CD;" />
                                    <Setter Property="Opacity" Value="0.52" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding VolumeGlyph}"
                           ToolTip="{Binding VolumeToolTip}"
                           Visibility="{Binding ShowVolumeStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Style="{StaticResource MenuBarStatusGlyphStyle}" />
                <StackPanel Orientation="Horizontal"
                            Margin="8,0,0,0"
                            Visibility="{Binding BatteryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Width="20" Height="12" VerticalAlignment="Center">
                        <Border Width="17"
                                Height="10"
                                BorderBrush="{DynamicResource MenuBarTextBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                HorizontalAlignment="Left" />
                        <Border Width="{Binding BatteryFillWidth}"
                                Height="6"
                                Margin="2,0,0,0"
                                Background="{DynamicResource MenuBarTextBrush}"
                                CornerRadius="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
                        <Border Width="2"
                                Height="4"
                                Margin="0,0,0,0"
                                Background="{DynamicResource MenuBarTextBrush}"
                                CornerRadius="0,1,1,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding BatteryText}"
                               Style="{StaticResource MenuBarTextStyle}"
                               Margin="4,0,0,0" />
                </StackPanel>
                <Button x:Name="ControlCenterButton"
                        Style="{StaticResource MenuBarIconButtonStyle}"
                        ToolTip="Control Center"
                        AutomationProperties.Name="Open Control Center"
                        Click="OnControlCenterClick">
                    <Grid Width="16" Height="13">
                        <Border Height="2"
                                CornerRadius="1"
                                Background="{DynamicResource MenuBarTextBrush}"
                                VerticalAlignment="Top"
                                Margin="1,2,1,0" />
                        <Ellipse Width="5" Height="5"
                                 Fill="{DynamicResource MenuBarTextBrush}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="3,0,0,0" />
                        <Border Height="2"
                                CornerRadius="1"
                                Background="{DynamicResource MenuBarTextBrush}"
                                VerticalAlignment="Bottom"
                                Margin="1,0,1,2" />
                        <Ellipse Width="5" Height="5"
                                 Fill="{DynamicResource MenuBarTextBrush}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,3,0" />
                    </Grid>
                </Button>
                <TextBlock Text="{Binding TimeText}"
                           Style="{StaticResource MenuBarTextStyle}"
                           Margin="10,0,1,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
