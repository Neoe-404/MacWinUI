<Window x:Class="MacWinUI.App.Views.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MacWinUI.Core.Models;assembly=MacWinUI.Core"
        Title="{DynamicResource String.Window.ControlCenterTitle}"
        Width="392"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI"
        Deactivated="OnDeactivated"
        DpiChanged="OnDpiChanged"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid x:Name="ControlCenterRoot"
          Margin="10"
          Opacity="0"
          AutomationProperties.Name="{DynamicResource String.Automation.ControlCenter}"
          KeyboardNavigation.TabNavigation="Cycle"
          KeyboardNavigation.DirectionalNavigation="Contained"
          RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ControlCenterTranslate" />
        </Grid.RenderTransform>

        <Border Style="{StaticResource ControlCenterPanelStyle}">
            <ScrollViewer x:Name="ControlCenterScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly">
            <StackPanel>
                <Grid Margin="4,2,4,11">
                    <TextBlock Text="{DynamicResource String.ControlCenter.Title}"
                               Style="{StaticResource ControlCenterTitleStyle}" />
                    <TextBlock Text="MacWinUI"
                               Style="{StaticResource ControlCenterSecondaryTextStyle}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <UniformGrid Columns="3" Margin="-3,0,-3,9">
                    <Button Style="{StaticResource ControlCenterActionButtonStyle}"
                            ToolTip="{DynamicResource String.Automation.OpenNetwork}"
                            AutomationProperties.Name="{DynamicResource String.Automation.OpenNetwork}"
                            Command="{Binding OpenSettingsCommand}"
                            CommandParameter="{x:Static models:SystemSettingsPage.Network}">
                        <StackPanel>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border"
                                           BasedOn="{StaticResource ControlCenterQuickIconSurfaceStyle}">
                                        <Setter Property="Background" Value="{DynamicResource ControlCenterAccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNetworkAvailable}" Value="False">
                                                <Setter Property="Opacity" Value="0.48" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="&#xE701;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource ControlCenterSelectedTextBrush}"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource String.ControlCenter.Network}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,7,0,0" />
                            <TextBlock Text="{Binding NetworkStatusText}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ControlCenterActionButtonStyle}"
                            ToolTip="{DynamicResource String.Automation.OpenBluetooth}"
                            AutomationProperties.Name="{DynamicResource String.Automation.OpenBluetooth}"
                            Command="{Binding OpenSettingsCommand}"
                            CommandParameter="{x:Static models:SystemSettingsPage.Bluetooth}">
                        <StackPanel>
                            <Border Style="{StaticResource ControlCenterQuickIconSurfaceStyle}">
                                <TextBlock Text="&#xE702;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource String.ControlCenter.Bluetooth}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,7,0,0" />
                            <TextBlock Text="{DynamicResource String.ControlCenter.Settings}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ControlCenterActionButtonStyle}"
                            ToolTip="{DynamicResource String.Automation.OpenSound}"
                            AutomationProperties.Name="{DynamicResource String.Automation.OpenSound}"
                            Command="{Binding OpenSettingsCommand}"
                            CommandParameter="{x:Static models:SystemSettingsPage.Sound}">
                        <StackPanel>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border"
                                           BasedOn="{StaticResource ControlCenterQuickIconSurfaceStyle}">
                                        <Setter Property="Background" Value="{DynamicResource ControlCenterAccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AudioAvailable}" Value="False">
                                                <Setter Property="Opacity" Value="0.48" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="&#xE767;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource ControlCenterSelectedTextBrush}"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource String.ControlCenter.Sound}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,7,0,0" />
                            <TextBlock Text="{Binding VolumeText}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Border Style="{StaticResource ControlCenterCardStyle}"
                        Margin="0,0,0,9"
                        Visibility="{Binding HasBattery, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34"
                                Height="34"
                                CornerRadius="17"
                                Background="{DynamicResource ControlCenterSuccessBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE850;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{DynamicResource ControlCenterSelectedTextBrush}"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource String.ControlCenter.Battery}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="{DynamicResource String.ControlCenter.PowerStatus}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding BatteryStatusText}"
                                   Style="{StaticResource ControlCenterSectionTitleStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ControlCenterCardStyle}"
                        Margin="0,0,0,9">
                    <StackPanel>
                        <Grid Margin="2,0,2,8">
                            <TextBlock Text="{DynamicResource String.ControlCenter.Sound}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="{Binding VolumeText}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{Binding MuteGlyph}"
                                    ToolTip="{DynamicResource String.Automation.Mute}"
                                    AutomationProperties.Name="{DynamicResource String.Automation.Mute}"
                                    Style="{StaticResource ControlCenterIconButtonStyle}"
                                    Command="{Binding ToggleMuteCommand}"
                                    CommandParameter="{Binding IsMuted}"
                                    IsEnabled="{Binding AudioAvailable}" />
                            <Slider Grid.Column="2"
                                    AutomationProperties.Name="{DynamicResource String.Automation.SystemVolume}"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding AudioAvailable}"
                                    Style="{StaticResource ControlCenterSliderStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ControlCenterCardStyle}"
                        Margin="0,0,0,9">
                    <StackPanel>
                        <Grid Margin="2,0,2,7">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.ControlCenter.DockItems}"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource String.ControlCenter.ApplicationsAndFiles}"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,72,0" />
                            </StackPanel>
                            <Button Content="{DynamicResource String.ControlCenter.Add}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ToolTip="{DynamicResource String.Status.DockPrompt}"
                                    AutomationProperties.Name="{DynamicResource String.Automation.AddDock}"
                                    Style="{StaticResource ControlCenterCompactButtonStyle}"
                                    Click="OnAddDockApplicationClick" />
                        </Grid>

                        <TextBlock Text="{Binding DockApplicationsStatusText}"
                                   Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="2,0,2,4" />

                        <ItemsControl ItemsSource="{Binding CustomDockItems}"
                                      AutomationProperties.Name="{DynamicResource String.Automation.CustomDockItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,5,2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28"
                                                Height="28"
                                                CornerRadius="7"
                                                Background="{DynamicResource ControlCenterIconSurfaceBrush}">
                                            <Image Width="24"
                                                   Height="24"
                                                   Stretch="Uniform"
                                                   Source="{Binding IconPngData, Converter={StaticResource ByteArrayToImageSourceConverter}}" />
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DisplayName}"
                                                   Style="{StaticResource ControlCenterSectionTitleStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3"
                                                Content="{DynamicResource String.ControlCenter.Remove}"
                                                Margin="8,0,0,0"
                                                ToolTip="{DynamicResource String.Dock.Remove}"
                                                AutomationProperties.Name="{DynamicResource String.Automation.RemoveDock}"
                                                Style="{StaticResource ControlCenterCompactButtonStyle}"
                                                Command="{Binding DataContext.RemoveDockApplicationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ControlCenterCardStyle}">
                    <StackPanel>
                        <Grid Margin="2,0,2,8">
                            <TextBlock Text="{DynamicResource String.ControlCenter.Appearance}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="{DynamicResource String.ControlCenter.MacWinUIOnly}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ListBox ItemsSource="{Binding ThemeOptions}"
                                 AutomationProperties.Name="{DynamicResource String.Automation.Theme}"
                                 SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                 Style="{StaticResource ControlCenterThemeListStyle}"
                                 ItemContainerStyle="{StaticResource ControlCenterThemeItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <Grid Margin="2,0,2,7">
                            <TextBlock Text="{DynamicResource String.ControlCenter.Language}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="{DynamicResource String.ControlCenter.LanguageDescription}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ListBox ItemsSource="{Binding LanguageOptions}"
                                 AutomationProperties.Name="{DynamicResource String.Automation.Language}"
                                 SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                 Style="{StaticResource ControlCenterThemeListStyle}"
                                 ItemContainerStyle="{StaticResource ControlCenterThemeItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <Grid Margin="2,0,2,9">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.ControlCenter.Backup}"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource String.ControlCenter.BackupDescription}"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,130,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="{DynamicResource String.ControlCenter.Import}"
                                        Style="{StaticResource ControlCenterCompactButtonStyle}"
                                        Margin="0,0,6,0"
                                        Click="OnImportSettingsClick" />
                                <Button Content="{DynamicResource String.ControlCenter.Export}"
                                        Style="{StaticResource ControlCenterCompactButtonStyle}"
                                        Click="OnExportSettingsClick" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <Grid Margin="2,0">
                            <TextBlock Text="{DynamicResource String.ControlCenter.DockSize}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="{Binding DockIconSizeText}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="32"
                                AutomationProperties.Name="{DynamicResource String.Automation.DockSize}"
                                Maximum="64"
                                Margin="2,5,2,5"
                                Value="{Binding DockIconSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ControlCenterSliderStyle}" />

                        <Grid Margin="2,2,2,0">
                            <TextBlock Text="{DynamicResource String.ControlCenter.DockOpacity}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="{Binding DockOpacityText}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="55"
                                AutomationProperties.Name="{DynamicResource String.Automation.DockOpacity}"
                                Maximum="100"
                                Margin="2,5,2,2"
                                Value="{Binding DockOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ControlCenterSliderStyle}" />

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <Grid Margin="2,0,2,9">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.ControlCenter.DockMagnification}"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource String.ControlCenter.DockMagnificationDescription}"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,48,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding EnableMagnification, Mode=TwoWay}"
                                      AutomationProperties.Name="{DynamicResource String.Automation.DockMagnification}"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="2,0,2,9">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.ControlCenter.AutoHide}"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource String.ControlCenter.AutoHideDescription}"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,48,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding AutoHideDock, Mode=TwoWay}"
                                      AutomationProperties.Name="{DynamicResource String.Automation.AutoHide}"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="2,0,2,9">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.ControlCenter.WindowMaterial}"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource String.ControlCenter.WindowMaterialDescription}"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,48,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding EnableBlur, Mode=TwoWay}"
                                      AutomationProperties.Name="{DynamicResource String.Automation.WindowMaterial}"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="2,0,2,0">
                            <TextBlock Text="{DynamicResource String.ControlCenter.MaterialIntensity}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="{Binding MaterialIntensityText}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="35"
                                Maximum="100"
                                Margin="2,5,2,9"
                                AutomationProperties.Name="{DynamicResource String.Automation.MaterialIntensity}"
                                Value="{Binding MaterialIntensityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ControlCenterSliderStyle}" />

                        <Grid Margin="2,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.ControlCenter.ReduceMotion}"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource String.ControlCenter.ReduceMotionDescription}"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,48,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding ReduceMotion, Mode=TwoWay}"
                                      AutomationProperties.Name="{DynamicResource String.Automation.ReduceMotion}"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <Grid Margin="2,0,2,7">
                            <TextBlock Text="{DynamicResource String.ControlCenter.Display}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="{DynamicResource String.ControlCenter.PlacementTarget}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ListBox ItemsSource="{Binding DisplayModes}"
                                 AutomationProperties.Name="{DynamicResource String.Automation.DisplayTarget}"
                                 SelectedItem="{Binding SelectedDisplayMode, Mode=TwoWay}"
                                 Style="{StaticResource ControlCenterThemeListStyle}"
                                 ItemContainerStyle="{StaticResource ControlCenterThemeItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <TextBlock Text="{DynamicResource String.ControlCenter.MenuBar}"
                                   Style="{StaticResource ControlCenterSectionTitleStyle}"
                                   Margin="2,0,2,9" />

                        <Grid Margin="2,0,2,9">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.ControlCenter.ReserveScreenSpace}"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource String.ControlCenter.ReserveScreenSpaceDescription}"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,48,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding ReserveMenuBarSpace, Mode=TwoWay}"
                                      AutomationProperties.Name="{DynamicResource String.Automation.ReserveScreenSpace}"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="2,0,2,9">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.ControlCenter.Use24HourTime}"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource String.ControlCenter.Use24HourTimeDescription}"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,48,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding Use24HourClock, Mode=TwoWay}"
                                      AutomationProperties.Name="{DynamicResource String.Automation.Use24HourTime}"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="2,0,2,9">
                            <TextBlock Text="{DynamicResource String.ControlCenter.ShowNetwork}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding ShowNetworkStatus, Mode=TwoWay}"
                                      AutomationProperties.Name="{DynamicResource String.Automation.ShowNetwork}"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="2,0,2,9">
                            <TextBlock Text="{DynamicResource String.ControlCenter.ShowVolume}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding ShowVolumeStatus, Mode=TwoWay}"
                                      AutomationProperties.Name="{DynamicResource String.Automation.ShowVolume}"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="2,0">
                            <TextBlock Text="{DynamicResource String.ControlCenter.ShowBattery}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding ShowBatteryStatus, Mode=TwoWay}"
                                      AutomationProperties.Name="{DynamicResource String.Automation.ShowBattery}"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right" />
                        </Grid>

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <Grid Margin="2,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource String.ControlCenter.ResetPreferences}"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource String.ControlCenter.ResetDescription}"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,80,0" />
                            </StackPanel>
                            <Button Content="{DynamicResource String.ControlCenter.ResetButton}"
                                    AutomationProperties.Name="{DynamicResource String.Automation.ResetPreferences}"
                                    Style="{StaticResource ControlCenterCompactButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Click="OnResetSettingsClick" />
                        </Grid>

                        <Border x:Name="ResetConfirmation"
                                Margin="2,10,2,0"
                                Padding="10"
                                Background="{DynamicResource ControlCenterCardPressedBrush}"
                                CornerRadius="9"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.ControlCenter.ResetQuestion}"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource String.ControlCenter.ResetDetails}"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{DynamicResource String.ControlCenter.Cancel}"
                                            AutomationProperties.Name="{DynamicResource String.Automation.CancelReset}"
                                            Style="{StaticResource ControlCenterCompactButtonStyle}"
                                            Margin="0,0,7,0"
                                            Click="OnCancelResetClick" />
                                    <Button Content="{DynamicResource String.ControlCenter.Reset}"
                                            AutomationProperties.Name="{DynamicResource String.Automation.ConfirmReset}"
                                            Style="{StaticResource ControlCenterDangerButtonStyle}"
                                            Click="OnConfirmResetClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <Grid Margin="2,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource String.ControlCenter.Quit}"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource String.ControlCenter.QuitDescription}"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,80,0" />
                            </StackPanel>
                            <Button Content="{DynamicResource String.ControlCenter.QuitButton}"
                                    AutomationProperties.Name="{DynamicResource String.Automation.Quit}"
                                    Style="{StaticResource ControlCenterDangerButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Click="OnQuitApplicationClick" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Style="{StaticResource ControlCenterPanelHighlightStyle}" />
    </Grid>
</Window>
