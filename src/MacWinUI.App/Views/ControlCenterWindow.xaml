<Window x:Class="MacWinUI.App.Views.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MacWinUI.Core.Models;assembly=MacWinUI.Core"
        Title="MacWinUI Control Center"
        Width="392"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI"
        Deactivated="OnDeactivated"
        DpiChanged="OnDpiChanged"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid x:Name="ControlCenterRoot"
          Margin="10"
          Opacity="0"
          AutomationProperties.Name="MacWinUI Control Center"
          KeyboardNavigation.TabNavigation="Cycle"
          KeyboardNavigation.DirectionalNavigation="Contained"
          RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ControlCenterTranslate" />
        </Grid.RenderTransform>

        <Border Style="{StaticResource ControlCenterPanelStyle}">
            <ScrollViewer x:Name="ControlCenterScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly">
            <StackPanel>
                <Grid Margin="4,2,4,11">
                    <TextBlock Text="{DynamicResource String.ControlCenter.Title}"
                               Style="{StaticResource ControlCenterTitleStyle}" />
                    <TextBlock Text="MacWinUI"
                               Style="{StaticResource ControlCenterSecondaryTextStyle}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <UniformGrid Columns="3" Margin="-3,0,-3,9">
                    <Button Style="{StaticResource ControlCenterActionButtonStyle}"
                            ToolTip="Open network settings"
                            AutomationProperties.Name="Open network settings"
                            Command="{Binding OpenSettingsCommand}"
                            CommandParameter="{x:Static models:SystemSettingsPage.Network}">
                        <StackPanel>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border"
                                           BasedOn="{StaticResource ControlCenterQuickIconSurfaceStyle}">
                                        <Setter Property="Background" Value="{DynamicResource ControlCenterAccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNetworkAvailable}" Value="False">
                                                <Setter Property="Opacity" Value="0.48" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="&#xE701;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource ControlCenterSelectedTextBrush}"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Network"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,7,0,0" />
                            <TextBlock Text="{Binding NetworkStatusText}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ControlCenterActionButtonStyle}"
                            ToolTip="Open Bluetooth settings"
                            AutomationProperties.Name="Open Bluetooth settings"
                            Command="{Binding OpenSettingsCommand}"
                            CommandParameter="{x:Static models:SystemSettingsPage.Bluetooth}">
                        <StackPanel>
                            <Border Style="{StaticResource ControlCenterQuickIconSurfaceStyle}">
                                <TextBlock Text="&#xE702;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Bluetooth"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,7,0,0" />
                            <TextBlock Text="Settings"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ControlCenterActionButtonStyle}"
                            ToolTip="Open sound settings"
                            AutomationProperties.Name="Open sound settings"
                            Command="{Binding OpenSettingsCommand}"
                            CommandParameter="{x:Static models:SystemSettingsPage.Sound}">
                        <StackPanel>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border"
                                           BasedOn="{StaticResource ControlCenterQuickIconSurfaceStyle}">
                                        <Setter Property="Background" Value="{DynamicResource ControlCenterAccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AudioAvailable}" Value="False">
                                                <Setter Property="Opacity" Value="0.48" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="&#xE767;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource ControlCenterSelectedTextBrush}"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Sound"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,7,0,0" />
                            <TextBlock Text="{Binding VolumeText}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Border Style="{StaticResource ControlCenterCardStyle}"
                        Margin="0,0,0,9"
                        Visibility="{Binding HasBattery, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34"
                                Height="34"
                                CornerRadius="17"
                                Background="{DynamicResource ControlCenterSuccessBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE850;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{DynamicResource ControlCenterSelectedTextBrush}"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Battery"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="Power status"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding BatteryStatusText}"
                                   Style="{StaticResource ControlCenterSectionTitleStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ControlCenterCardStyle}"
                        Margin="0,0,0,9">
                    <StackPanel>
                        <Grid Margin="2,0,2,8">
                            <TextBlock Text="Sound"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="{Binding VolumeText}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{Binding MuteGlyph}"
                                    ToolTip="Mute or unmute"
                                    AutomationProperties.Name="Mute or unmute audio"
                                    Style="{StaticResource ControlCenterIconButtonStyle}"
                                    Command="{Binding ToggleMuteCommand}"
                                    CommandParameter="{Binding IsMuted}"
                                    IsEnabled="{Binding AudioAvailable}" />
                            <Slider Grid.Column="2"
                                    AutomationProperties.Name="System volume"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding AudioAvailable}"
                                    Style="{StaticResource ControlCenterSliderStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ControlCenterCardStyle}"
                        Margin="0,0,0,9">
                    <StackPanel>
                        <Grid Margin="2,0,2,7">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.ControlCenter.DockItems}"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="Applications and files"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,72,0" />
                            </StackPanel>
                            <Button Content="Add…"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ToolTip="Choose an application or file"
                                    AutomationProperties.Name="Add an application or file to the Dock"
                                    Style="{StaticResource ControlCenterCompactButtonStyle}"
                                    Click="OnAddDockApplicationClick" />
                        </Grid>

                        <TextBlock Text="{Binding DockApplicationsStatusText}"
                                   Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="2,0,2,4" />

                        <ItemsControl ItemsSource="{Binding CustomDockItems}"
                                      AutomationProperties.Name="Custom Dock applications">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,5,2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28"
                                                Height="28"
                                                CornerRadius="7"
                                                Background="{DynamicResource ControlCenterIconSurfaceBrush}">
                                            <Image Width="24"
                                                   Height="24"
                                                   Stretch="Uniform"
                                                   Source="{Binding IconPngData, Converter={StaticResource ByteArrayToImageSourceConverter}}" />
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DisplayName}"
                                                   Style="{StaticResource ControlCenterSectionTitleStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3"
                                                Content="Remove"
                                                Margin="8,0,0,0"
                                                ToolTip="Remove from Dock"
                                                AutomationProperties.Name="Remove application from Dock"
                                                Style="{StaticResource ControlCenterCompactButtonStyle}"
                                                Command="{Binding DataContext.RemoveDockApplicationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ControlCenterCardStyle}">
                    <StackPanel>
                        <Grid Margin="2,0,2,8">
                            <TextBlock Text="{DynamicResource String.ControlCenter.Appearance}"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="MacWinUI only"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ListBox ItemsSource="{Binding ThemeOptions}"
                                 AutomationProperties.Name="MacWinUI theme"
                                 SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                 Style="{StaticResource ControlCenterThemeListStyle}"
                                 ItemContainerStyle="{StaticResource ControlCenterThemeItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <Grid Margin="2,0,2,9">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.ControlCenter.Backup}"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="Export or restore appearance and Dock layout"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,130,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Content="Import…"
                                        Style="{StaticResource ControlCenterCompactButtonStyle}"
                                        Margin="0,0,6,0"
                                        Click="OnImportSettingsClick" />
                                <Button Content="Export…"
                                        Style="{StaticResource ControlCenterCompactButtonStyle}"
                                        Click="OnExportSettingsClick" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <Grid Margin="2,0">
                            <TextBlock Text="Dock size"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="{Binding DockIconSizeText}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="32"
                                AutomationProperties.Name="Dock icon size"
                                Maximum="64"
                                Margin="2,5,2,5"
                                Value="{Binding DockIconSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ControlCenterSliderStyle}" />

                        <Grid Margin="2,2,2,0">
                            <TextBlock Text="Dock opacity"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="{Binding DockOpacityText}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="55"
                                AutomationProperties.Name="Dock opacity"
                                Maximum="100"
                                Margin="2,5,2,2"
                                Value="{Binding DockOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ControlCenterSliderStyle}" />

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <Grid Margin="2,0,2,9">
                            <StackPanel>
                                <TextBlock Text="Dock magnification"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="Magnify nearby icons"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,48,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding EnableMagnification, Mode=TwoWay}"
                                      AutomationProperties.Name="Dock magnification"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="2,0,2,9">
                            <StackPanel>
                                <TextBlock Text="Automatically hide Dock"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="Reveal it at the bottom screen edge"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,48,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding AutoHideDock, Mode=TwoWay}"
                                      AutomationProperties.Name="Automatically hide Dock"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="2,0,2,9">
                            <StackPanel>
                                <TextBlock Text="Window material"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="Use blur when available"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,48,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding EnableBlur, Mode=TwoWay}"
                                      AutomationProperties.Name="Window material"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="2,0,2,0">
                            <TextBlock Text="Material intensity"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="{Binding MaterialIntensityText}"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="35"
                                Maximum="100"
                                Margin="2,5,2,9"
                                AutomationProperties.Name="Window material intensity"
                                Value="{Binding MaterialIntensityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ControlCenterSliderStyle}" />

                        <Grid Margin="2,0">
                            <StackPanel>
                                <TextBlock Text="Reduce motion"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="Disable magnify, bounce and popup motion"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,48,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding ReduceMotion, Mode=TwoWay}"
                                      AutomationProperties.Name="Reduce motion"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <Grid Margin="2,0,2,7">
                            <TextBlock Text="Display"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}" />
                            <TextBlock Text="Placement target"
                                       Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ListBox ItemsSource="{Binding DisplayModes}"
                                 AutomationProperties.Name="Display placement target"
                                 SelectedItem="{Binding SelectedDisplayMode, Mode=TwoWay}"
                                 Style="{StaticResource ControlCenterThemeListStyle}"
                                 ItemContainerStyle="{StaticResource ControlCenterThemeItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <TextBlock Text="{DynamicResource String.ControlCenter.MenuBar}"
                                   Style="{StaticResource ControlCenterSectionTitleStyle}"
                                   Margin="2,0,2,9" />

                        <Grid Margin="2,0,2,9">
                            <StackPanel>
                                <TextBlock Text="Reserve screen space"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="Keep Windows controls below the Menu Bar"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,48,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding ReserveMenuBarSpace, Mode=TwoWay}"
                                      AutomationProperties.Name="Reserve screen space for Menu Bar"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="2,0,2,9">
                            <StackPanel>
                                <TextBlock Text="24-hour time"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="Use the HH:mm clock format"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,48,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding Use24HourClock, Mode=TwoWay}"
                                      AutomationProperties.Name="Use 24-hour time"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="2,0,2,9">
                            <TextBlock Text="Show network"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding ShowNetworkStatus, Mode=TwoWay}"
                                      AutomationProperties.Name="Show network in Menu Bar"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="2,0,2,9">
                            <TextBlock Text="Show volume"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding ShowVolumeStatus, Mode=TwoWay}"
                                      AutomationProperties.Name="Show volume in Menu Bar"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="2,0">
                            <TextBlock Text="Show battery"
                                       Style="{StaticResource ControlCenterSectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding ShowBatteryStatus, Mode=TwoWay}"
                                      AutomationProperties.Name="Show battery in Menu Bar"
                                      Style="{StaticResource ControlCenterToggleStyle}"
                                      HorizontalAlignment="Right" />
                        </Grid>

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <Grid Margin="2,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Reset preferences"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="Restore safe defaults"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,80,0" />
                            </StackPanel>
                            <Button Content="Reset…"
                                    AutomationProperties.Name="Reset appearance preferences"
                                    Style="{StaticResource ControlCenterCompactButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Click="OnResetSettingsClick" />
                        </Grid>

                        <Border x:Name="ResetConfirmation"
                                Margin="2,10,2,0"
                                Padding="10"
                                Background="{DynamicResource ControlCenterCardPressedBrush}"
                                CornerRadius="9"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Reset all MacWinUI appearance preferences?"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="The Dock, Menu Bar and display settings will return to defaults."
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel"
                                            AutomationProperties.Name="Cancel reset"
                                            Style="{StaticResource ControlCenterCompactButtonStyle}"
                                            Margin="0,0,7,0"
                                            Click="OnCancelResetClick" />
                                    <Button Content="Reset"
                                            AutomationProperties.Name="Confirm reset preferences"
                                            Style="{StaticResource ControlCenterDangerButtonStyle}"
                                            Click="OnConfirmResetClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ControlCenterDividerStyle}" />

                        <Grid Margin="2,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource String.ControlCenter.Quit}"
                                           Style="{StaticResource ControlCenterSectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource String.ControlCenter.QuitDescription}"
                                           Style="{StaticResource ControlCenterSecondaryTextStyle}"
                                           Margin="0,2,80,0" />
                            </StackPanel>
                            <Button Content="{DynamicResource String.ControlCenter.QuitButton}"
                                    AutomationProperties.Name="Quit MacWinUI"
                                    Style="{StaticResource ControlCenterDangerButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Click="OnQuitApplicationClick" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Style="{StaticResource ControlCenterPanelHighlightStyle}" />
    </Grid>
</Window>
